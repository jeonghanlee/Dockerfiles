DOCKER_BUILDER := $(TOP)/docker_builder.bash
TRIGGER_TOOL := $(TOP)/trigger.bash
GATE_TOOL := $(TOP)/gate.bash
LINK_CHECKER := $(TOP)/check_links.rb
VERSIONS_CHECKER := $(TOP)/check_versions.bash
RELEASE_TOOL := $(TOP)/release.bash
SCRIPT_FILES := $(DOCKER_BUILDER) $(TRIGGER_TOOL) $(GATE_TOOL) $(VERSIONS_CHECKER) $(RELEASE_TOOL)
WORKFLOW_FILES := $(wildcard $(TOP)/.github/workflows/*.yml)
IMAGE_DRY_RUN_TARGETS := $(addprefix dry-run.,$(IMAGE_DIRS))
IMAGE_BUILD_TARGETS := $(addprefix build.,$(IMAGE_DIRS))
VERSION_KEYS := $(shell sed -n 's/^\([A-Z0-9_]*\)=.*/\1/p' $(TOP)/configure/VERSIONS)
VERSION_ENV = $(foreach key,$(VERSION_KEYS),$(key)="$($(key))")
RELEASE_ENV = RELEASE_IMAGE_DIRS="$(RELEASE_IMAGE_DIRS)" RUNNER_IMAGE_DIRS="$(RUNNER_IMAGE_DIRS)" SLIM_IMAGE_DIRS="$(SLIM_IMAGE_DIRS)" HELD_VERSION_KEYS="$(HELD_VERSION_KEYS)" $(VERSION_ENV)
IMAGE_GATE_TARGETS :=$(addprefix gate.,$(RELEASE_IMAGE_DIRS)) $(addprefix gate.,$(RUNNER_IMAGE_DIRS)) $(addprefix gate.,$(SLIM_IMAGE_DIRS))

VARS_EXCLUDES += DOCKER_BUILDER TRIGGER_TOOL GATE_TOOL LINK_CHECKER VERSIONS_CHECKER RELEASE_TOOL SCRIPT_FILES
VARS_EXCLUDES += WORKFLOW_FILES IMAGE_DRY_RUN_TARGETS IMAGE_BUILD_TARGETS
VARS_EXCLUDES += IMAGE_GATE_TARGETS VERSION_KEYS VERSION_ENV RELEASE_ENV
