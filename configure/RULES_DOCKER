VARS_EXCLUDES += image_targets

.PHONY: all build dry-run gate check check-tools check-images check-scripts
.PHONY: check-workflows check-docs check-links check-diff docs trigger versions

##@ General
all: check ## Run the default validation suite

check: check-tools check-images check-scripts check-workflows check-docs check-links check-diff dry-run ## Run repository validation

versions: ## Print project and tool versions
	$(QUIET) printf "%s = %s\n" "APPNAME" "$(APPNAME)"
	$(QUIET) printf "%s = %s\n" "PROJECT_URL" "$(PROJECT_URL)"
	$(QUIET) printf "%s = %s\n" "IMAGE_DIRS" "$(IMAGE_DIRS)"
	$(QUIET) git --version
	$(QUIET) ruby --version
	$(QUIET) shellcheck --version | sed -n '1p'
	$(QUIET) yamllint --version
	$(QUIET) if command -v docker >/dev/null 2>&1; then docker --version; else printf "%s\n" "docker not found"; fi
	$(QUIET) for d in $(RELEASE_IMAGE_DIRS); do \
	    v="$$(grep -m1 -oE 'DIST_VERSION=[0-9.]+' "$(TOP)/$$d/Dockerfile" | cut -d= -f2)"; \
	    printf "%-10s DIST_VERSION = %s\n" "$$d" "$$v"; \
	done
	$(QUIET) printf "%s = %s\n" "repo git" "$$(git -C $(TOP) describe --tags --always 2>/dev/null)"

##@ Validation
check-tools: ## Verify tools required by validation targets
	$(QUIET) for tool in bash git ruby shellcheck yamllint; do \
	    if ! command -v "$$tool" >/dev/null 2>&1; then \
	        printf "%s\n" "error: required command not found: $$tool"; \
	        printf "%s\n" "install the validation packages listed in docs/SETUP.md"; \
	        exit 1; \
	    fi; \
	done

check-images: ## Verify each configured image has Dockerfile and env.conf
	$(QUIET) for image in $(IMAGE_DIRS); do \
	    test -s "$(TOP)/$$image/Dockerfile" || { printf "%s\n" "error: missing $$image/Dockerfile"; exit 1; }; \
	    test -s "$(TOP)/$$image/env.conf" || { printf "%s\n" "error: missing $$image/env.conf"; exit 1; }; \
	done

check-scripts: ## Run Bash syntax and ShellCheck validation
	$(QUIET) bash -n $(SCRIPT_FILES)
	$(QUIET) shellcheck -S warning $(SCRIPT_FILES)

check-workflows: ## Lint and parse GitHub Actions workflow YAML files
	$(QUIET) yamllint $(WORKFLOW_FILES)
	$(QUIET) ruby -e 'require "yaml"; ARGV.each { |path| YAML.load_file(path) }' $(WORKFLOW_FILES)

# The gitignored work/ scratch directory (issue drafts, commit messages) is
# not a tracked source and is excluded as a whole.
check-docs: ## Reject non-ASCII characters in Markdown sources
	$(QUIET) if LC_ALL=C grep -rnP '[^\x00-\x7F]' --include='*.md' --exclude-dir=work .; then \
	    printf "%s\n" "error: non-ASCII Markdown content found"; \
	    exit 1; \
	fi

check-links: ## Verify local file and image targets in Markdown sources
	$(QUIET) ruby $(LINK_CHECKER)

check-diff: ## Check staged and unstaged diff whitespace
	$(QUIET) git diff --check

##@ Documentation
docs: ## Build the mdBook site in public
	$(QUIET) if ! command -v docker >/dev/null 2>&1; then \
	    printf "%s\n" "error: required command not found: docker"; \
	    printf "%s\n" "install Docker Engine as described in docs/SETUP.md"; \
	    exit 1; \
	fi
	$(QUIET) docker run --rm \
	    --user "$$(id -u):$$(id -g)" \
	    --volume "$(abspath $(TOP)):/work" \
	    --workdir /work \
	    "$(MDBOOK_IMAGE)" \
	    bash -c "mdbook clean && mdbook build"

##@ Docker Images
build: $(IMAGE_BUILD_TARGETS) ## Build all active Docker images

dry-run: $(IMAGE_DRY_RUN_TARGETS) ## Preview all active Docker builds

gate: $(IMAGE_GATE_TARGETS) ## Run the container gate against all EPICS images

##@ Release
dist-version.%: ## Set DIST_VERSION across all EPICS image Dockerfiles (e.g. dist-version.1.2.2)
	$(QUIET) for d in $(RELEASE_IMAGE_DIRS); do \
	    sed -i -E "s/^(ARG DIST_VERSION=).*/\1$*/" "$(TOP)/$$d/Dockerfile"; \
	    printf "%-10s DIST_VERSION = %s\n" "$$d" "$*"; \
	done

trigger: ## Update tracked CI rebuild trigger file
	$(QUIET) $(TRIGGER_TOOL)

define image_targets
.PHONY: build.$(1) dry-run.$(1)

build.$(1): ## Build $(1) Docker image
	$$(QUIET) $$(DOCKER_BUILDER) -t $(1) $$(if $$(BUILD_ARGS),-a "$$(BUILD_ARGS)",)

dry-run.$(1): ## Preview $(1) Docker build command
	$$(QUIET) $$(DOCKER_BUILDER) -d -t $(1) $$(if $$(BUILD_ARGS),-a "$$(BUILD_ARGS)",)
endef

$(foreach image, $(IMAGE_DIRS), $(eval $(call image_targets,$(image))))

# Container gate targets, EPICS images only (RELEASE_IMAGE_DIRS excludes mdbook).
# The image name comes from the image's env.conf; gate.bash is mounted read-only
# and run in the default bridge network so localhost CA/PVA stays isolated.
define gate_target
.PHONY: gate.$(1)

gate.$(1): ## Run the container gate against the $(1) image
	$$(QUIET) . $$(TOP)/$(1)/env.conf; docker run --rm -v $$(GATE_TOOL):/gate.bash:ro $$$${DOCKER_ID}/$$$${TARGET_NAME} bash /gate.bash
endef

$(foreach image, $(RELEASE_IMAGE_DIRS), $(eval $(call gate_target,$(image))))

FORCE:
